# Copy to .env.local (git-ignored) and fill in. Leave ADO_PAT empty to use mock data.
# The token is only used by the local Vite server; it is never sent to the browser.

ADO_ORG=your-organization
ADO_PROJECT=Your Project
# Personal access token with scopes: Work Items (Read), Project and Team (Read)
ADO_PAT=

# Optional
# ADO_BASE_URL=https://dev.azure.com/your-organization   # or an Azure DevOps Server collection URL
# ADO_HOURS_PER_POINT=6        # converts Story Points / Effort / Size to hours when no hour estimate is set
# ADO_DEFAULT_CAPACITY=40      # hours per person per week
